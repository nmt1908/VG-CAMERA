<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="true">

    <!-- App Title Bar -->
    <LinearLayout
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="12dp"
        android:paddingHorizontal="24dp"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <ImageView
            android:id="@+id/appLogo"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/logo"
            android:contentDescription="App Logo"
            android:layout_marginEnd="16dp" />

        <TextView
            android:id="@+id/appTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textStyle="bold"
            android:text="VG Camera Login"
            android:textSize="22sp"
            android:textColor="#111111"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Face overlay -->
    <com.example.vgcamera.FaceGraphicOverlay
        android:id="@+id/graphicOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- User Info Panel (overlay, bottom) -->
    <LinearLayout
        android:id="@+id/userInfoPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="bottom"
        android:layout_marginBottom="48dp"
        android:layout_marginHorizontal="20dp"
        android:padding="24dp"
        android:background="@drawable/bg_vip_panel"
        android:visibility="invisible"
        android:elevation="24dp">

        <!-- Status & Loading Header -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <!-- Loading State -->
            <LinearLayout
                android:id="@+id/loadingContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/loadingSpinner"
                    android:layout_width="20dp"
                    android:layout_height="20dp" 
                    android:indeterminateTint="#007AFF" />

                <TextView
                    android:id="@+id/loadingText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Recognizing..."
                    android:textColor="#5f6368"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Alert Pill -->
            <TextView
                android:id="@+id/labelAlert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Camera Ready"
                android:textColor="#F57C00"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingVertical="6dp"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_alert_pill"
                android:fontFamily="sans-serif-medium" />
        </FrameLayout>

        <!-- Modern Profile Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            
            <!-- Dummy label for Java safety -->
            <TextView
                android:id="@+id/labelUserName"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <!-- Information Side -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/userName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nguyễn Văn A"
                    android:textColor="#1D1D1F"
                    android:textSize="22sp"
                    android:letterSpacing="-0.02"
                    android:fontFamily="sans-serif-black" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical">
                    
                    <TextView
                        android:id="@+id/labelUserCardId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CODE:"
                        android:textColor="#8E8E93"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="6dp" />
                        
                    <TextView
                        android:id="@+id/userCardId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="123456"
                        android:textColor="#5f6368"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </LinearLayout>

            <!-- Similarity Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/labelUserSimilarity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Match Rate"
                    android:textColor="#8E8E93"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/userSimilarity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="98.7%"
                    android:textColor="#34C759" 
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-black" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
